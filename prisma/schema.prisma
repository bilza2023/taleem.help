generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
enum CommunicationInitiator {
  STUDENT
  TEACHER
}

enum ContentType {
  ARTICLE
  PLAYER
  MCQ
}

enum LibraryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseAccess {
  OPEN
  MEMBERS
  SUBSCRIPTION
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

model Course {
  slug          String         @id
  title         String
  description   String?
  thumbnail     String?
  access        CourseAccess   @default(OPEN)
  isActive      Boolean        @default(true)
  price         Int            @default(0)

  groups        Group[]
  subscriptions Subscription[]
}


model Group {
  id         Int     @id @default(autoincrement())
  courseSlug String
  slug       String
  title      String
  thumbnail  String?
 description   String?
  course     Course  @relation(fields: [courseSlug], references: [slug], onDelete: Restrict)
  library    Library[]

  @@unique([courseSlug, slug])
  @@index([courseSlug])
}

model Library {
  slug               String        @id
  title              String
  description        String?
  thumbnail          String?
  type               ContentType
  status             LibraryStatus @default(DRAFT)
  body               String?
  courseSlug         String
  groupSlug          String
  sortOrder          Int           @default(0)
  allowCommunication Boolean       @default(true)
  meta               String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  group              Group         @relation(fields: [courseSlug, groupSlug], references: [courseSlug, slug], onDelete: Restrict)

  communications     Communication[]

  @@index([courseSlug])
  @@index([groupSlug])
}
model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  password       String
  name           String?
  role           String          @default("student")
  resource       String?
  createdAt      DateTime        @default(now())
  subscriptions  Subscription[]
  communications Communication[]
}

model Admin {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  password    String
  courseSlugs String    @default("[]")
  role        AdminRole @default(ADMIN)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}


model Subscription {
  id          Int       @id @default(autoincrement())
  userId      Int
  courseSlug  String
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  amount      Int?
  cancelledAt DateTime?

  user        User      @relation(fields: [userId], references: [id])
  course      Course    @relation(fields: [courseSlug], references: [slug], onDelete: Restrict)

  @@index([userId])
  @@index([courseSlug])
}

model Communication {
  id             Int       @id @default(autoincrement())
  userId         Int
  librarySlug    String
  type           String
  initiator CommunicationInitiator @default(STUDENT)
  meta           String?
  message        String
  authorResponse String?
  isPublic       Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id])
  library        Library   @relation(fields: [librarySlug], references: [slug], onDelete: Restrict)

  @@index([userId])
  @@index([librarySlug])
}

model Svg {
  slug String @id

  title String

  body String

  tags String @default("[]")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Image {
  slug String @id

  title String

  tags String @default("[]")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Audio {
  slug String @id

  title String

  tags String @default("[]")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}
